{
  "manifest_version": 3,
  "name": "Jackrabbit Exporter — Aqua Essence",
  "version": "1.1.0",
  "description": "Export students, classes, staff, and historical pairings from Jackrabbit Class for Aqua Essence.",
  "minimum_chrome_version": "121",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://*.jackrabbitclass.com/*",
    "https://*.jackrabbittech.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "jackrabbit-exporter@aqua-essence",
      "strict_min_version": "121.0"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.jackrabbitclass.com/*",
        "https://*.jackrabbittech.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Jackrabbit Exporter"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
